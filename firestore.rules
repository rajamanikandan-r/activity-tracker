rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Temporary open access ─────────────────────────────────────────────────
    // The app currently has no authentication.  These rules allow any client
    // that knows your project ID to read and write all data.
    //
    // This is acceptable for a private personal tracker, but you should
    // restrict access once you add Firebase Authentication:
    //
    //   allow read, write: if request.auth != null
    //                      && request.auth.uid == "YOUR_USER_UID";
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
